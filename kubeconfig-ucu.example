apiVersion: v1
kind: Config
clusters:
- name: ucu
  cluster:
    server: https://REPLACE_WITH_API_ENDPOINT
    certificate-authority-data: REPLACE_WITH_BASE64_CA
users:
- name: grupolegionarios
  user:
    token: REPLACE_WITH_TOKEN
contexts:
- name: ucu
  context:
    cluster: ucu
    user: grupolegionarios
    namespace: obligatorio-grupolegionarios
current-context: ucu
